---
interface Props {
  size?: number;
  state?: 'idle' | 'thinking' | 'talking' | 'success' | 'error' | 'greeting';
  id?: string;
  class?: string;
}

const { size = 40, state = 'idle', id = 'moose', class: className = '' } = Astro.props;
const prefix = id;
---

<div class:list={['moose-wrapper', className]} style={`width:${size}px;height:${size}px`} data-moose-id={id}>
  <svg viewBox="0 0 200 200" class={`mf-svg mf-${state}`}>
    <defs>
      <linearGradient id={`${prefix}-furDark`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#5c4a3d" /><stop offset="100%" stop-color="#3d3029" />
      </linearGradient>
      <linearGradient id={`${prefix}-furMid`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#8b7355" /><stop offset="50%" stop-color="#6d5a47" /><stop offset="100%" stop-color="#4a3d32" />
      </linearGradient>
      <linearGradient id={`${prefix}-furLight`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#a69076" /><stop offset="100%" stop-color="#8b7355" />
      </linearGradient>
      <linearGradient id={`${prefix}-furChest`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#d4c4a8" /><stop offset="100%" stop-color="#b8a88c" />
      </linearGradient>
      <linearGradient id={`${prefix}-antler`} x1="50%" y1="100%" x2="50%" y2="0%">
        <stop offset="0%" stop-color="#6b5d4d" /><stop offset="30%" stop-color="#9c8b74" /><stop offset="70%" stop-color="#c4b59c" /><stop offset="100%" stop-color="#e0d5c3" />
      </linearGradient>
      <linearGradient id={`${prefix}-wingPrimary`} x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#2d4a3e" /><stop offset="40%" stop-color="#1f3830" /><stop offset="100%" stop-color="#162822" />
      </linearGradient>
      <linearGradient id={`${prefix}-wingSecondary`} x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#4a6b5a" /><stop offset="50%" stop-color="#3d5a4a" /><stop offset="100%" stop-color="#2d4a3e" />
      </linearGradient>
      <linearGradient id={`${prefix}-wingAccent`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#c9a962" /><stop offset="50%" stop-color="#a68b4b" /><stop offset="100%" stop-color="#8b7340" />
      </linearGradient>
      <radialGradient id={`${prefix}-eyeOuter`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#4a3d28" /><stop offset="100%" stop-color="#2a1f14" />
      </radialGradient>
      <radialGradient id={`${prefix}-eyeInner`} cx="30%" cy="30%" r="60%">
        <stop offset="0%" stop-color="#c9a962" /><stop offset="60%" stop-color="#8b6b2a" /><stop offset="100%" stop-color="#5a4420" />
      </radialGradient>
      <linearGradient id={`${prefix}-beak`} x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#4a4038" /><stop offset="100%" stop-color="#2d2620" />
      </linearGradient>
      <radialGradient id={`${prefix}-glowGold`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#c9a962" stop-opacity="0.4" /><stop offset="100%" stop-color="#c9a962" stop-opacity="0" />
      </radialGradient>
      <filter id={`${prefix}-softGlow`} x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <circle class="glow-ring" cx="100" cy="95" r="75" fill={`url(#${prefix}-glowGold)`} />
    <ellipse class="crown-glow" cx="100" cy="35" rx="30" ry="20" fill={`url(#${prefix}-glowGold)`} />

    <g class="body-group">
      <!-- Tail feathers -->
      <g class="tail-feathers" style="transform-origin:100px 160px">
        <path d="M 85 155 Q 70 170 65 185 Q 80 175 90 165 Z" fill={`url(#${prefix}-wingPrimary)`} />
        <path d="M 95 158 Q 90 175 88 192 Q 98 178 100 165 Z" fill={`url(#${prefix}-wingSecondary)`} />
        <path d="M 105 158 Q 110 175 112 192 Q 102 178 100 165 Z" fill={`url(#${prefix}-wingSecondary)`} />
        <path d="M 115 155 Q 130 170 135 185 Q 120 175 110 165 Z" fill={`url(#${prefix}-wingPrimary)`} />
      </g>

      <!-- Left wing -->
      <g class="wing-left" style="transform-origin:65px 100px">
        <path d="M 62 90 Q 30 75 15 55 Q 18 70 22 82 Q 8 72 5 85 Q 15 95 25 98 Q 10 100 12 115 Q 25 112 35 108 Q 22 120 30 130 Q 42 122 52 115 Q 45 130 55 138 L 62 115 Z" fill={`url(#${prefix}-wingPrimary)`} />
        <path d="M 60 95 Q 40 85 30 75 Q 35 88 40 95 Q 28 92 25 102 Q 38 102 48 100 Q 38 110 45 118 L 58 108 Z" fill={`url(#${prefix}-wingSecondary)`} />
        <path d="M 55 92 Q 38 88 28 82" stroke={`url(#${prefix}-wingAccent)`} stroke-width="3" fill="none" stroke-linecap="round" />
        <path d="M 52 102 Q 35 100 25 98" stroke={`url(#${prefix}-wingAccent)`} stroke-width="2" fill="none" stroke-linecap="round" opacity="0.7" />
      </g>

      <!-- Right wing -->
      <g class="wing-right" style="transform-origin:135px 100px">
        <path d="M 138 90 Q 170 75 185 55 Q 182 70 178 82 Q 192 72 195 85 Q 185 95 175 98 Q 190 100 188 115 Q 175 112 165 108 Q 178 120 170 130 Q 158 122 148 115 Q 155 130 145 138 L 138 115 Z" fill={`url(#${prefix}-wingPrimary)`} />
        <path d="M 140 95 Q 160 85 170 75 Q 165 88 160 95 Q 172 92 175 102 Q 162 102 152 100 Q 162 110 155 118 L 142 108 Z" fill={`url(#${prefix}-wingSecondary)`} />
        <path d="M 145 92 Q 162 88 172 82" stroke={`url(#${prefix}-wingAccent)`} stroke-width="3" fill="none" stroke-linecap="round" />
        <path d="M 148 102 Q 165 100 175 98" stroke={`url(#${prefix}-wingAccent)`} stroke-width="2" fill="none" stroke-linecap="round" opacity="0.7" />
      </g>

      <!-- Body -->
      <ellipse cx="100" cy="120" rx="40" ry="42" fill={`url(#${prefix}-furMid)`} />
      <ellipse cx="100" cy="130" rx="25" ry="28" fill={`url(#${prefix}-furChest)`} />
      <ellipse cx="100" cy="138" rx="18" ry="18" fill={`url(#${prefix}-furLight)`} opacity="0.5" />
      <path d="M 88 118 Q 92 128 88 140" stroke="#c4b49a" stroke-width="1" fill="none" opacity="0.4" />
      <path d="M 100 115 Q 100 130 100 145" stroke="#c4b49a" stroke-width="1" fill="none" opacity="0.4" />
      <path d="M 112 118 Q 108 128 112 140" stroke="#c4b49a" stroke-width="1" fill="none" opacity="0.4" />

      <!-- Head -->
      <ellipse cx="100" cy="85" rx="28" ry="22" fill={`url(#${prefix}-furMid)`} />
      <ellipse cx="100" cy="62" rx="30" ry="28" fill={`url(#${prefix}-furLight)`} />
      <path d="M 75 55 Q 85 50 100 48 Q 115 50 125 55 Q 120 62 100 65 Q 80 62 75 55 Z" fill={`url(#${prefix}-furMid)`} opacity="0.6" />

      <!-- Ears -->
      <g class="ear-left" style="transform-origin:72px 42px">
        <path d="M 72 48 Q 60 35 55 25 Q 52 35 58 45 Q 65 50 72 48 Z" fill={`url(#${prefix}-furMid)`} />
        <path d="M 68 45 Q 62 38 60 32" stroke="#d4c4a8" stroke-width="2" fill="none" opacity="0.5" />
      </g>
      <g class="ear-right" style="transform-origin:128px 42px">
        <path d="M 128 48 Q 140 35 145 25 Q 148 35 142 45 Q 135 50 128 48 Z" fill={`url(#${prefix}-furMid)`} />
        <path d="M 132 45 Q 138 38 140 32" stroke="#d4c4a8" stroke-width="2" fill="none" opacity="0.5" />
      </g>

      <!-- Antlers -->
      <g filter={`url(#${prefix}-softGlow)`}>
        <path d="M 78 45 Q 72 30 65 15 M 72 30 Q 60 28 52 22 M 72 30 Q 65 22 58 18 M 68 38 Q 55 38 45 35 M 68 38 Q 58 32 50 28" fill="none" stroke={`url(#${prefix}-antler)`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="65" cy="15" r="2.5" fill="#e0d5c3" /><circle cx="52" cy="22" r="2" fill="#e0d5c3" /><circle cx="58" cy="18" r="2" fill="#e0d5c3" /><circle cx="45" cy="35" r="2" fill="#e0d5c3" /><circle cx="50" cy="28" r="2" fill="#e0d5c3" />
        <path d="M 122 45 Q 128 30 135 15 M 128 30 Q 140 28 148 22 M 128 30 Q 135 22 142 18 M 132 38 Q 145 38 155 35 M 132 38 Q 142 32 150 28" fill="none" stroke={`url(#${prefix}-antler)`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="135" cy="15" r="2.5" fill="#e0d5c3" /><circle cx="148" cy="22" r="2" fill="#e0d5c3" /><circle cx="142" cy="18" r="2" fill="#e0d5c3" /><circle cx="155" cy="35" r="2" fill="#e0d5c3" /><circle cx="150" cy="28" r="2" fill="#e0d5c3" />
      </g>

      <!-- Eyes -->
      <g class="eyes">
        <ellipse cx="85" cy="60" rx="8" ry="9" fill={`url(#${prefix}-eyeOuter)`} />
        <ellipse cx="85" cy="60" rx="5" ry="6" fill={`url(#${prefix}-eyeInner)`} />
        <ellipse cx="85" cy="60" rx="2.5" ry="3" fill="#1a1408" />
        <circle cx="83" cy="58" r="1.5" fill="#fff" opacity="0.8" />
        <ellipse cx="115" cy="60" rx="8" ry="9" fill={`url(#${prefix}-eyeOuter)`} />
        <ellipse cx="115" cy="60" rx="5" ry="6" fill={`url(#${prefix}-eyeInner)`} />
        <ellipse cx="115" cy="60" rx="2.5" ry="3" fill="#1a1408" />
        <circle cx="113" cy="58" r="1.5" fill="#fff" opacity="0.8" />
      </g>

      <!-- Brows -->
      <path d="M 78 52 Q 85 50 92 52" stroke="#4a3d32" stroke-width="1.5" fill="none" opacity="0.5" />
      <path d="M 108 52 Q 115 50 122 52" stroke="#4a3d32" stroke-width="1.5" fill="none" opacity="0.5" />

      <!-- Beak -->
      <g class="beak" style="transform-origin:100px 72px">
        <path d="M 95 68 Q 100 65 105 68 L 103 75 Q 100 78 97 75 Z" fill={`url(#${prefix}-beak)`} />
        <ellipse cx="100" cy="70" rx="3" ry="2" fill="#1a1408" opacity="0.8" />
        <ellipse cx="98" cy="68" rx="1.5" ry="1" fill="#5a4a3a" opacity="0.5" />
      </g>

      <path d="M 94 77 Q 100 80 106 77" stroke="#4a3d32" stroke-width="1" fill="none" opacity="0.4" />

      <!-- Feet -->
      <ellipse cx="85" cy="162" rx="8" ry="4" fill="#3d3029" />
      <ellipse cx="115" cy="162" rx="8" ry="4" fill="#3d3029" />
    </g>
  </svg>
</div>
