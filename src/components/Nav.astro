---
import MooseSVG from './MooseSVG.astro';
---

<nav class="fixed top-0 left-0 right-0 z-50 glass-nav" id="main-nav">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <div id="nav-moose">
        <MooseSVG size={40} state="idle" id="nav" />
      </div>
      <span class="text-xl font-semibold gradient-text">FAESR</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="/moose" class="hover:text-gold transition-colors duration-300 text-foreground-muted">Moose</a>
      <a href="/research" class="hover:text-gold transition-colors duration-300 text-foreground-muted">Research</a>
      <a href="https://github.com/moosefinch" target="_blank" rel="noopener noreferrer" class="btn-outline flex items-center gap-2 px-4 py-2 text-cream rounded-lg">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
        </svg>
        GitHub
      </a>
    </div>

    <button class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px]" aria-label="Toggle menu" id="mobile-menu-btn">
      <span class="block w-6 h-[2px] bg-cream transition-all duration-300"></span>
      <span class="block w-6 h-[2px] bg-cream transition-all duration-300"></span>
      <span class="block w-6 h-[2px] bg-cream transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="md:hidden hidden" id="mobile-menu">
    <div class="px-6 py-4 border-t border-white/5 flex flex-col gap-4">
      <a href="/moose" class="text-foreground-muted hover:text-gold transition-colors">Moose</a>
      <a href="/research" class="text-foreground-muted hover:text-gold transition-colors">Research</a>
      <a href="https://github.com/moosefinch" target="_blank" rel="noopener noreferrer" class="text-foreground-muted hover:text-gold transition-colors">GitHub</a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const spans = btn.querySelectorAll('span');
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      spans[0].style.transform = 'rotate(45deg) translate(2px, 6px)';
      spans[1].style.opacity = '0';
      spans[2].style.transform = 'rotate(-45deg) translate(2px, -6px)';
    } else {
      spans[0].style.transform = '';
      spans[1].style.opacity = '';
      spans[2].style.transform = '';
    }
  });
</script>
